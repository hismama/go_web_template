{{ define "base_fullwidth" }}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ block "title" . }}Default Title{{ end }}</title>
  <link rel="stylesheet" href="/static/css/css-reset.css">
  <link rel="stylesheet" href="/static/css/main.css">
</head>
<body>
  <nav class="navbar">
    {{ template "navbar" . }}
  </nav>

  <header class="header">
{{/*    {{ template "header" . }}*/}}
  </header>

  <main class="fullwidth">
    {{ block "content" . }}{{ end }}
  </main>

  <footer class="footer">
{{/*    {{ template "footer" . }}*/}}
  </footer>

</body>
</html>
{{ end }}